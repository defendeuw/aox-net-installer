{
  "name": "aox-bootstrapper",
  "version": "1.0.0",
  "description": "AoX Net Installer - Downloads and installs the Armies of Exigo Matchmaking Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.aox.net.installer",
    "productName": "AoX Net Installer",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AoX Net",
      "artifactName": "AoX-Net-Installer-Setup.exe",
      "deleteAppDataOnUninstall": true
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "24.13.3"
  },
  "dependencies": {
    "unzipper": "^0.10.14"
  }
}
